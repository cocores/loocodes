# Copy to .env.local (gitignored) for local dev, and add the same variables
# in Vercel Project Settings → Environment Variables for deploys.

# See web/README.md#public-sharing-firebase--firestore
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point at `firebase emulators:start` instead of a real project.
# VITE_FIRESTORE_EMULATOR_HOST=localhost:8080

# See web/README.md#google-maps-setup
VITE_GOOGLE_MAPS_API_KEY=
